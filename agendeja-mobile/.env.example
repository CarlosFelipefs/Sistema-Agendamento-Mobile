# Configuração da URL da API (AgendeJá Mobile)
# IMPORTANTE: A API deve rodar em modo HTTP (não HTTPS) para desenvolvimento mobile
# Execute a API com: dotnet run --urls "http://0.0.0.0:5253"
# Libere também a porta 5253 no Firewall do Windows

# Para celular físico na mesma rede Wi-Fi:
# Substitua <IP-DO-PC> pelo IP local do seu computador (ex.: 192.168.1.100)
# EXPO_PUBLIC_API_URL=http://<IP-DO-PC>:5253

# Para emulador Android (endereço de loopback do host):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5253

# Para simulador iOS:
# EXPO_PUBLIC_API_URL=http://localhost:5253

# Para web (localhost):
# EXPO_PUBLIC_API_URL=http://localhost:5253
